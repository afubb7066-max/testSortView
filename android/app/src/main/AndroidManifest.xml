<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Full file access (Android 11+). Used from Phase 1 onward. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Legacy storage permission for Android 8/9/10 (maxSdk 29). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- Foreground service that keeps file transfers alive while the app is
         backgrounded (dataSync type required by API 34+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Transfer progress notification (Android 13+ runtime permission).
         The service keeps running and moving files without it; only the
         visible progress notification with its Stop button is suppressed,
         so it is requested once after file access is granted and a denial
         is non-fatal. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Framework theme on purpose: no com.google.android.material
             dependency (that library owns the Theme.Material3 XML styles); the
             real UI is drawn entirely by Compose MaterialTheme inside MainActivity. -->
        <!-- requestLegacyExternalStorage: on Android 10 devices the classic
             READ/WRITE pair then gives File-based access to shared storage,
             matching the desktop's plain-filesystem behavior. -->

        <!-- Secure content:// URIs for "Open with system player"
             (Phase 3, media/SystemPlayer.kt). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transfer keep-alive (started only while the app is in the
             foreground, right before the enqueue loop; stops itself when
             the queue has been idle for its grace period). -->
        <service
            android:name=".transfer.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
